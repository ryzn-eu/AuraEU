class VOID_VOID_VOID_0020 {
    constructor(){
        this.a = this.b = this.c = this.d = this.e = 0;
    }
    spin(){
        for(let i=0;i<100;i++){
            this.a++;
            this.b--;
            this.c+=0;
            this.d*=1;
            this.e/=1;
        }
    }
}

